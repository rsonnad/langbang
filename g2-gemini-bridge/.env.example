# Gemini Live API.
LANGBANGTRANS_GEMINI_API_KEY=
LANGBANGTRANS_GEMINI_MODEL=gemini-3.5-live-translate-preview
LANGBANGTRANS_GEMINI_WS_ENDPOINT=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
LANGBANGTRANS_TARGET_LANGUAGE_CODE=en
LANGBANGTRANS_ECHO_TARGET_LANGUAGE=true

# Current Live Translate docs use AUDIO for translated output plus text
# transcriptions. TEXT is available here only as an explicit strict-text
# experiment and may not be accepted by the translate model.
LANGBANGTRANS_RESPONSE_MODALITIES=AUDIO
LANGBANGTRANS_PLAY_OUTPUT_AUDIO=false

# Audio capture is 20 ms for local latency, then coalesced into 100 ms Gemini
# sends to match the Live Translate recommendation.
LANGBANGTRANS_CAPTURE_SAMPLE_RATE=16000
LANGBANGTRANS_CAPTURE_FRAME_MS=20
LANGBANGTRANS_GEMINI_AUDIO_CHUNK_MS=100
LANGBANGTRANS_OUTPUT_SAMPLE_RATE=24000
LANGBANGTRANS_INPUT_DEVICE=
LANGBANGTRANS_OUTPUT_DEVICE=

# BLE discovery and transport. Leave dry-run enabled until UUIDs/init/header
# bytes are confirmed from a known-good G2 BLE session.
LANGBANGTRANS_DRY_RUN=true
LANGBANGTRANS_G2_NAME_REGEX=Even G2|G2
LANGBANGTRANS_G2_SERVICE_UUID=
LANGBANGTRANS_G2_WRITE_CHAR_UUID=
LANGBANGTRANS_G2_NOTIFY_CHAR_UUID=
LANGBANGTRANS_G2_INIT_PACKETS_HEX=
LANGBANGTRANS_G2_LAYOUT_HEADER_HEX=
LANGBANGTRANS_G2_MAX_PACKET_BYTES=180
LANGBANGTRANS_G2_PACKET_DELAY_MS=25
LANGBANGTRANS_G2_CRC_ENCODING=ascii-hex

# HUD layout.
LANGBANGTRANS_HUD_COLUMNS=28
LANGBANGTRANS_HUD_LINES=10
LANGBANGTRANS_TRANSCRIPT_MODE=append

# Logging.
LANGBANGTRANS_LOG_LEVEL=INFO
LANGBANGTRANS_LOG_FILE=logs/langbangtrans.log

